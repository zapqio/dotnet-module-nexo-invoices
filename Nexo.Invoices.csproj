<Project Sdk="Microsoft.NET.Sdk">

	<!-- Moduł faktur dla Zapqio Runner: konsument paczki współdzielonej Nexo.Connection. -->
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<DeterministicSourcePaths>true</DeterministicSourcePaths>
	</PropertyGroup>

	<ItemGroup>
		<!-- Obie paczki tylko do kompilacji: w runtime kontrakt dostarcza runner, a NexoClient i SDK
		     przychodzą z zipa Nexo.Connection w Modules\. Referencje do SDK importuje props tej paczki. -->
		<PackageReference Include="Zapqio.Runner.Module.Core" Version="1.0.0" ExcludeAssets="runtime" />
		<PackageReference Include="Zapqio.Nexo.Connection" Version="1.0.3" ExcludeAssets="runtime" />
	</ItemGroup>

	<!--Zip after publish-->
	<Target Name="ZipAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<ZipFileName>$(MSBuildProjectName).zip</ZipFileName>
			<ZipFilePath>$(PublishDir)..\$(ZipFileName)</ZipFilePath>
		</PropertyGroup>
		<!--Lista bibliotek, ktore runner ma skanowac-->
		<WriteLinesToFile File="$(PublishDir)##Dll" Lines="$(TargetFileName)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<Delete Files="$(ZipFilePath)" Condition="Exists('$(ZipFilePath)')" />
		<ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipFilePath)" />
		<Message Importance="High" Text="Created: $(ZipFilePath)" />
	</Target>

</Project>
